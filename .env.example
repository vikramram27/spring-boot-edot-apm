# ==========================================
# Application Environment
# ==========================================
# Options: development | staging | production
APP_ENV=development
SPRING_PROFILES_ACTIVE=dev

# Application Server
SERVER_PORT=8080
APP_HOST_PORT=8088

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=edot_apm
DB_USER=sample_user_x9f2
DB_PASSWORD=r4nd0m_p4ss_7k3m_sample

# PostgreSQL Container Credentials
POSTGRES_DB=edot_apm
POSTGRES_USER=sample_user_x9f2
POSTGRES_PASSWORD=r4nd0m_p4ss_7k3m_sample

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380

# JWT Security (Must be at least 256 bits)
JWT_SECRET=r4nd0m_s3cr3t_h4sh_k3y_9f7a8b6c5d4e3f2a1b0c_f1nt3ch_2026
JWT_EXPIRATION_MS=86400000

# ==========================================
# Elastic OpenTelemetry (EDOT) APM Configuration
# ==========================================
# Set to 'true' if running offline without an APM collector, or 'false' to export
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=payment-gateway-api

# Environment tagging: 'development', 'staging', or 'production'
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,service.version=1.0.0

# Elastic APM OTLP collector endpoint (e.g. http://<apm-host>:8200)
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.150:8200

# Elastic Authorization header (must be HeaderName=HeaderValue)
OTEL_EXPORTER_OTLP_HEADERS='Authorization=Bearer r4nd0m_t0k3n_8f2a9c1e7b4d_sample'

# Metrics & Logs exporters
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Enable inferred spans for deep CPU profiling via async-profiler
OTEL_INFERRED_SPANS_ENABLED=true
